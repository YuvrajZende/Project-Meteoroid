# ===========================================
# LOVEABLE BACKEND - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in the values

# -----------------
# Server Settings
# -----------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
w
# API versioning
API_VERSION=v1
API_PREFIX=/api

# -----------------
# Supabase (Database & Auth) # password for the supabase project : 4K%23Pvf+%24zpubHaR
# -----------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase webhook secret (for auth events)
SUPABASE_WEBHOOK_SECRET=your-webhook-secret

# -----------------
# Redis (Cache, Queue, Rate Limiting)
# -----------------
REDIS_URL=redis://localhost:6379

# -----------------
# AI Provider Keys (Rotation Pool)
# -----------------
# You can specify multiple keys separated by commas for rotation
# Single key: OPENAI_API_KEY=sk-xxx
# Multiple keys: OPENAI_KEYS=sk-xxx1,sk-xxx2,sk-xxx3

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_KEYS=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_KEYS=

# Z.AI (GLM-4) - RECOMMENDED FOR CODE GENERATION
ZAI_API_KEY=your-zai-key
ZAI_KEYS=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# DeepSeek V3 (Direct API)
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_KEYS=

# OpenRouter (RECOMMENDED for DeepSeek V3 - cheaper, more reliable)
OPENROUTER_API_KEY=your-openrouter-key

# Together AI (optional - for alternative models)
TOGETHER_API_KEY=

# -----------------
# Multi-Model Pipeline (Phase 13)
# -----------------
# RECOMMENDED SETUP:
# - FAST: DeepSeek V3 via OpenRouter (cheap, high quality analysis)
# - POWER: GLM-4-Plus via Z.AI (great for code generation)

# Fast model for analysis (cheap, quick - ~$0.0001/request)
FAST_MODEL_PROVIDER=openrouter
FAST_MODEL_NAME=deepseek/deepseek-chat

# Powerful model for code generation (quality - ~$0.01/request)
# IMPORTANT: Use glm-4.6 for Z.AI (correct model name)
POWER_MODEL_PROVIDER=zai
POWER_MODEL_NAME=glm-4.6

# Default model (used when not in multi-model mode)
MODEL_NAME=glm-4.6

# -----------------
# Cost Budget Limits
# -----------------
DAILY_BUDGET_USD=10.00
MONTHLY_BUDGET_USD=100.00
BUDGET_ALERT_THRESHOLD=0.8
BUDGET_HARD_LIMIT=false

# -----------------
# JWT & Authentication
# -----------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# -----------------
# CORS
# -----------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------
# Rate Limiting
# -----------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# -----------------
# Stripe (Payments)
# -----------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# -----------------
# GitHub (Webhooks)
# -----------------
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# -----------------
# Monitoring & Observability
# -----------------
SENTRY_DSN=
LOG_LEVEL=info

# Datadog (optional)
DD_API_KEY=
DD_APP_KEY=

# -----------------
# Feature Flags
# -----------------
ENABLE_COST_TRACKING=true
ENABLE_VECTOR_SEARCH=true
ENABLE_MULTI_MODEL=true

# -----------------
# Development/Testing
# -----------------
# Your authenticated Supabase user UUID (from auth.users)
# Used for database persistence in development
TEST_USER_ID=6461ad32-3dcb-4760-87b2-c4f7458025e3
