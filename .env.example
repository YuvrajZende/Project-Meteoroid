# ===========================================
# METEOROID BACKEND - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in the values

# -----------------
# Server Settings
# -----------------
NODE_ENV=development

# Require a verified Supabase token on AI/destructive routes.
# Defaults to true when NODE_ENV=production, false otherwise.
AUTH_REQUIRED=false

# Where generated projects are written (default: <repo>/output)
OUTPUT_DIR=
PORT=3000
HOST=0.0.0.0

# API versioning
API_VERSION=v1
API_PREFIX=/api

# -----------------
# Supabase (Database & Auth)
# -----------------
# SECURITY: Never commit actual passwords or keys here!
# Get these values from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase webhook secret (for auth events)
SUPABASE_WEBHOOK_SECRET=your-webhook-secret

# -----------------
# Convex (New Database - Phase 5 Migration)
# -----------------
# Get CONVEX_URL from: npx convex dev
# Example: CONVEX_URL=https://jolly-badger-123.convex.cloud
CONVEX_URL=your-convex-deployment-url

# -----------------
# Redis (Cache, Queue, Rate Limiting)
# -----------------
REDIS_URL=redis://localhost:6379

# -----------------
# AI Provider Keys (Rotation Pool)
# -----------------
# You can specify multiple keys separated by commas for rotation
# Single key: OPENAI_API_KEY=sk-xxx
# Multiple keys: OPENAI_KEYS=sk-xxx1,sk-xxx2,sk-xxx3

# OpenAI (sent only to api.openai.com - never to other providers)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_KEYS=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_KEYS=

# Z.AI (GLM) - optional; uses ONLY ZAI_API_KEY + ZAI_BASE_URL
ZAI_API_KEY=your-zai-key
ZAI_KEYS=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# DeepSeek (Direct API: deepseek-flash, deepseek-v4-pro)
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_KEYS=

# OpenRouter - ONE KEY FOR EVERYTHING (see "Single key" below)
# Get your key at: https://openrouter.ai/keys
# Format: starts with "sk-or-v1-"
OPENROUTER_API_KEY=

# Web search tool (optional): agents research current docs before generating.
# Set one of these; Tavily is preferred when both are set.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Groq - RECOMMENDED FOR FAST MODEL (Ultra-fast LPU inference)
GROQ_API_KEY=your-groq-key

# Together AI (optional - for alternative models)
TOGETHER_API_KEY=

# -----------------
# Single key: OpenRouter gateway (recommended)
# -----------------
# Set only OPENROUTER_API_KEY (above) and every AI call goes through OpenRouter with that one key:
# planner, builder, fallback, chat, prompt enhancer, every sub-agent and custom agent, and embeddings.
# AI_GATEWAY: auto (default: use OpenRouter whenever OPENROUTER_API_KEY is set) | direct (use each provider's own key)
AI_GATEWAY=auto

# Optional: pick any model from https://openrouter.ai/models (overrides FAST/POWER_MODEL_NAME in gateway mode)
OPENROUTER_FAST_MODEL=
OPENROUTER_POWER_MODEL=

# -----------------
# Multi-Model Pipeline
# -----------------
# FAST = planner/analysis, POWER = code generation for every sub-agent.
# Registry ids work with their own provider key, or through OpenRouter in gateway mode.
# If the chosen model isn't reachable, the first model in the priority list that is gets used.

# Fast model for analysis
# Options: llama-3.3-70b-versatile, openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.1-8b-instant,
#          deepseek-flash, gpt-6-luna, claude-haiku-4-5-20251001
FAST_MODEL_NAME=llama-3.3-70b-versatile

# Powerful model for code generation
# Options: qwen/qwen3.6-plus, deepseek-v4-pro, claude-sonnet-5-5, claude-opus-5-5, gpt-6.1-sol, gpt-6-astra, glm-4.6
POWER_MODEL_NAME=qwen/qwen3.6-plus

# Optional explicit fallback for failed generations (default: next configured power model)
FALLBACK_MODEL_NAME=

# Hard wall-time cap per model call in ms, retries included (timeouts are not retried)
FAST_MODEL_TIMEOUT=30000
POWER_MODEL_TIMEOUT=600000

# Max output tokens for generation (clamped to the model's limit)
POWER_MODEL_MAX_TOKENS=16384

# Subtasks generated in parallel per request
SUBTASK_CONCURRENCY=3

# Default model (used when not in multi-model mode)
MODEL_NAME=qwen/qwen3.6-plus

# -----------------
# Cost Budget Limits
# -----------------
DAILY_BUDGET_USD=10.00
MONTHLY_BUDGET_USD=100.00
BUDGET_ALERT_THRESHOLD=0.8
BUDGET_HARD_LIMIT=false

# -----------------
# JWT & Authentication (Phase 19 - Security Hardening)
# -----------------
# At least 32 characters, use a cryptographically secure random string
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Token expiry times (format: Xs, Xm, Xh, Xd)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Token issuer and audience
JWT_ISSUER=meteoroid-backend
JWT_AUDIENCE=meteoroid-api

# -----------------
# Encryption (AES-256-GCM)
# -----------------
# Master encryption key - CRITICAL: Use a strong, unique key (32+ characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-character-encryption-key-change-in-production

# Salt for key derivation (unique per deployment)
ENCRYPTION_SALT=your-unique-salt-for-key-derivation

# -----------------
# CSRF Protection
# -----------------
# CSRF secret (if not set, defaults to JWT_SECRET)
CSRF_SECRET=your-csrf-secret-for-token-signing


# -----------------
# CORS
# -----------------
# Comma-separated list of allowed origins
# The web app (packages/web) runs on 3001
CORS_ORIGINS=http://localhost:3001

# -----------------
# Rate Limiting
# -----------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# -----------------
# Stripe (Payments)
# -----------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# -----------------
# GitHub (Webhooks)
# -----------------
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# -----------------
# Monitoring & Observability
# -----------------
SENTRY_DSN=
LOG_LEVEL=info

# Datadog (optional)
DD_API_KEY=
DD_APP_KEY=

# -----------------
# Feature Flags
# -----------------
ENABLE_COST_TRACKING=true
ENABLE_VECTOR_SEARCH=true
ENABLE_MULTI_MODEL=true

# -----------------
# Development/Testing
# -----------------
# Your authenticated Supabase user UUID (from auth.users)
# Used for database persistence in development
TEST_USER_ID=00000000-0000-0000-0000-000000000000

# -----------------
# Phase 14: Stack Constraints
# -----------------
# Default stack preset (api, web, fullstack, mobile, microservices, serverless)
DEFAULT_STACK_PRESET=api

# Enable strict stack constraint enforcement
STRICT_STACK_CONSTRAINTS=true

# Auto-detect stack from project description
AUTO_DETECT_STACK=true

# -----------------
# Phase 15: Automated Deployment Pipeline
# -----------------

# GitHub OAuth (for repository integration)
# Setup: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL must be: http://localhost:3000/api/v1/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/github/callback
GITHUB_APP_NAME=Meteoroid Backend

# Netlify (for deployments)
# Setup: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=
NETLIFY_TEAM_ID=

# Vercel (alternative deployment provider)
# Setup: https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Default deployment provider (netlify or vercel)
DEFAULT_DEPLOY_PROVIDER=netlify

# Auto-deploy after code generation (set to true to enable)
AUTO_DEPLOY_ENABLED=true

# -----------------
# Phase 16: Real-Time Preview & Collaboration
# -----------------

# Enable preview service
PREVIEW_ENABLED=true

# ESM CDN URL for browser-native module imports
ESM_CDN_URL=https://esm.sh

# HMR debounce delay in milliseconds
HMR_DEBOUNCE_MS=100

# Maximum preview sessions per project
PREVIEW_MAX_SESSIONS=10

# Global cap on preview sessions across all projects (oldest evicted)
PREVIEW_MAX_TOTAL_SESSIONS=200

# Preview session timeout in milliseconds (default: 1 hour)
PREVIEW_SESSION_TIMEOUT=3600000

# Enable collaboration features (cursor presence, real-time sync)
COLLABORATION_ENABLED=true

# Sandbox CSP policy for preview iframes
PREVIEW_SANDBOX_POLICY=allow-scripts allow-same-origin allow-popups allow-forms

# -----------------
# Phase 21: Service Integration Framework
# -----------------

# Enable service integration features
SERVICE_INTEGRATION_ENABLED=true

# Encryption key for service credentials (32+ characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_ENCRYPTION_KEY=your-32-character-service-encryption-key

# Auto-initialize service registry at startup
SERVICE_REGISTRY_AUTO_INIT=true

# Interactive service selection (ask users about missing services)
INTERACTIVE_SERVICE_SELECTION=true
