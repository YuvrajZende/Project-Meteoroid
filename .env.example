# ===========================================
# CORE CONFIGURATION
# ===========================================
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# ===========================================
# API GENERATOR CONFIGURATION
# ===========================================
API_GENERATOR_NAME=Loveable Backend API Generator
API_GENERATOR_VERSION=1.0.0

# ===========================================
# ALLOWED ORIGINS FOR CORS
# ===========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4200

# ===========================================
# DATABASE CONFIGURATION (Optional for Week 1)
# ===========================================
# PostgreSQL (primary)
POSTGRES_URL=postgresql://user:password@localhost:5432/loveable_db

# MongoDB (optional)
MONGODB_URL=mongodb://localhost:27017/loveable_mongo

# Redis (caching)
REDIS_URL=redis://localhost:6379

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# JWT secrets (will be implemented in later weeks)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ===========================================
# AI MODEL CONFIGURATION (for later weeks)
# ===========================================
# AI models will be integrated by Person 2
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here

# ===========================================
# DEVELOPMENT ONLY
# ===========================================
# Feature flags
ENABLE_API_DEBUGGING=true
ENABLE_SWAGGER=true
SAVE_GENERATED_CODE=true
