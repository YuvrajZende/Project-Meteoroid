{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2022"
        ],
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "composite": true,
        "baseUrl": ".",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "paths": {
            "@loveable/orchestrator": [
                "packages/orchestrator/src"
            ],
            "@loveable/agents": [
                "agents/index.ts"
            ],
            "@loveable/agents/*": [
                "agents/*"
            ],
            "@loveable/shared": [
                "packages/shared/src"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "dist"
    ],
    "include": [
        "packages/api/src/**/*.ts",
        "packages/shared/src/**/*.ts",
        "packages/orchestrator/src/**/*.ts",
        "packages/agents/src/**/*.ts"
    ]
}