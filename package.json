{
  "name": "meteoroid-backend",
  "version": "2.0.0",
  "private": true,
  "description": "AI-powered backend builder with intelligent orchestration",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @meteoroid/shared -w @meteoroid/api",
    "start": "node scripts/dev.mjs --open",
    "dev:all": "node scripts/dev.mjs",
    "dev": "npm run dev -w @meteoroid/api",
    "dev:web": "npm run dev -w @meteoroid/web",
    "test": "npm run test -w @meteoroid/api",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "type-check": "tsc -p tsconfig.json && npm run type-check -w @meteoroid/api",
    "orchestrator": "npx ts-node packages/orchestrator/src/index.ts",
    "orchestrator:dev": "nodemon --watch packages/orchestrator/src --ext ts --exec \"npx ts-node packages/orchestrator/src/index.ts\"",
    "switch-models": "npx ts-node scripts/switch-models.ts",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "keywords": [
    "ai",
    "backend",
    "orchestrator",
    "langgraph",
    "agents",
    "code-generation"
  ],
  "author": "Person 1",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.19.26",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.29.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@langchain/core": "^1.1.4",
    "@langchain/groq": "^1.0.2",
    "@langchain/langgraph": "^1.0.4",
    "@langchain/openai": "^1.1.3",
    "dotenv": "^17.2.3",
    "inversify": "^7.11.0",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
