{
    "name": "@meteoroid/api",
    "version": "1.0.0",
    "description": "Production Fastify API server for Meteoroid Backend Orchestrator",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "lint": "eslint src --ext .ts",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:unit": "vitest run src/repositories",
        "test:e2e": "vitest run --config vitest.e2e.config.ts test/e2e",
        "test:e2e:ui": "playwright test",
        "test:all": "vitest run && vitest run --config vitest.e2e.config.ts test/e2e",
        "smoke-test": "tsx src/tests/smoke-test.ts",
        "db:health": "tsx -e \"import { checkDatabaseHealth } from './src/infrastructure/database/database-client.js'; checkDatabaseHealth().then(console.log)\"",
        "db:test": "tsx -e \"import { testDatabaseOperations } from './src/infrastructure/database/database-client.js'; testDatabaseOperations().then(console.log)\""
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/cors": "^10.0.1",
        "@fastify/helmet": "^12.0.1",
        "@fastify/rate-limit": "^10.2.0",
        "@fastify/sensible": "^6.0.1",
        "@fastify/swagger": "^9.3.0",
        "@fastify/swagger-ui": "^5.2.0",
        "@meteoroid/shared": "*",
        "@octokit/rest": "^22.0.1",
        "@supabase/supabase-js": "^2.87.1",
        "adm-zip": "^0.5.16",
        "bullmq": "^5.30.1",
        "dotenv": "^17.2.3",
        "fastify": "^5.1.0",
        "inversify": "^7.11.0",
        "ioredis": "^5.4.1",
        "pino-pretty": "^13.0.0",
        "reflect-metadata": "^0.2.2",
        "uuid": "^10.0.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@types/adm-zip": "^0.5.7",
        "@types/node": "^22.19.7",
        "@types/uuid": "^10.0.0",
        "@vitest/coverage-v8": "^2.1.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vitest": "^2.1.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
